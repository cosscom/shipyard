{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shipyard",
  "version": "0.3.25",
  "identifier": "dev.berth.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shipyard",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:1378 https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1378 ws://127.0.0.1:1378 data:; frame-src http://*.localhost:* http://*.localhost http://localhost:* http://127.0.0.1:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "berth"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyRjgwQTIwQzRFOTQyMjMKUldRalF1bkVJQXI0MGxrUFdXL1ZZM0JwSW9rQm85ZTZnR1NlbWlPN1piUjVsUmxGMS9RM2RBeHAK",
      "endpoints": [
        "https://github.com/cosscom/shipyard/releases/latest/download/latest.json"
      ]
    }
  }
}
