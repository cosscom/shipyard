{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the app's own webview (label main) gets these. Browser panes are child webviews in the same window, labelled browser-*, and get nothing: pages loaded there cannot reach Tauri.",
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "notification:default",
    "shell:allow-open",
    "deep-link:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ],
  "webviews": [
    "main"
  ]
}
