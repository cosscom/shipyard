{
  "name": "berth-phone",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export": "expo export --platform ios --output-dir .expo-export"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@berth/core/(.*)$": "<rootDir>/../packages/core/src/$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ]
  }
}
